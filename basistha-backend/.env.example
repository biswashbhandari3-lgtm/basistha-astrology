# Basistha Astronomical Engine - Environment Configuration
ENVIRONMENT=production
PORT=8000
HOST=0.0.0.0

# Security
SECRET_KEY=change_this_to_a_random_secure_secret_key_minimum_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,https://basistha.vercel.app,https://vedaschakshu.com

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/basistha_astrology
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your_password
PG_DBNAME=basistha_astrology
DB_POOL_MIN=1
DB_POOL_MAX=10

# Astronomical Defaults
DEFAULT_AYANAMSHA=LAHIRI
DEFAULT_HOUSE_SYSTEM=P
DEFAULT_TIMEZONE_OFFSET=5.75
